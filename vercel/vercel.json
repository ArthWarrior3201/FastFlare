{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/cdn/:path*", "destination": "/api/cdn?p=:path*" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Content-Type-Options", "value": "nosniff" }] }
  ],
  "git": { "deploymentEnabled": { "cdn": false } }
}
